#!/bin/bash

### 安装后钩子：记录关键环境信息，便于诊断
### 实际初始化（config.json 复制）由 init 容器完成（解耦 fnOS 时序依赖）

{
  echo "=== ds2api install_callback ==="
  echo "时间: $(date -Iseconds 2>/dev/null || date)"
  echo "TRIM_APPNAME: ${TRIM_APPNAME:-<unset>}"
  echo "TRIM_APPVER: ${TRIM_APPVER:-<unset>}"
  echo "TRIM_APPDEST: ${TRIM_APPDEST:-<unset>}"
  echo "TRIM_PKGVAR: ${TRIM_PKGVAR:-<unset>}"
  echo "TRIM_SERVICE_PORT: ${TRIM_SERVICE_PORT:-<unset>}"
  echo "ds2api_admin_key (length): ${#ds2api_admin_key}"
  echo "目标 docker-compose.yaml 存在: $([ -f "${TRIM_APPDEST}/docker/docker-compose.yaml" ] && echo yes || echo no)"
  echo "目标 config.example.json 存在: $([ -f "${TRIM_APPDEST}/docker/config.example.json" ] && echo yes || echo no)"
  echo "PKGVAR 目录: ${TRIM_PKGVAR:-<unset>}"
  echo "==============================="
} >> "${TRIM_TEMP_LOGFILE:-/tmp/ds2api-install.log}" 2>&1

exit 0

#!/bin/bash

### 安装后钩子：首次启动准备 config.json（幂等）

DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/config.json"

mkdir -p "${DATA_DIR}"

# 首次安装：从包内模板复制 config.json
if [ ! -f "${CONFIG_FILE}" ]; then
  if [ -f "${TRIM_APPDEST}/app/config.example.json" ]; then
    cp "${TRIM_APPDEST}/app/config.example.json" "${CONFIG_FILE}"
    chmod 600 "${CONFIG_FILE}"
  else
    echo "config.example.json not found in app package." > "${TRIM_TEMP_LOGFILE}"
    exit 1
  fi
fi

{
  echo "=== ds2api install_callback ==="
  echo "时间: $(date -Iseconds 2>/dev/null || date)"
  echo "TRIM_APPNAME: ${TRIM_APPNAME:-<unset>}"
  echo "TRIM_APPVER: ${TRIM_APPVER:-<unset>}"
  echo "TRIM_APPDEST: ${TRIM_APPDEST:-<unset>}"
  echo "TRIM_PKGVAR: ${TRIM_PKGVAR:-<unset>}"
  echo "TRIM_SERVICE_PORT: ${TRIM_SERVICE_PORT:-<unset>}"
  echo "ds2api_admin_key (length): ${#ds2api_admin_key}"
  echo "config.json: ${CONFIG_FILE} ($(if [ -f "${CONFIG_FILE}" ]; then echo "exists, $(wc -c < "${CONFIG_FILE}") bytes"; else echo "missing"; fi))"
  echo "二进制: ${TRIM_APPDEST}/app/ds2api ($(if [ -x "${TRIM_APPDEST}/app/ds2api" ]; then echo "executable"; else echo "NOT executable"; fi))"
  echo "WebUI: ${TRIM_APPDEST}/app/static/admin ($(ls "${TRIM_APPDEST}/app/static/admin" 2>/dev/null | wc -l) files)"
  echo "==============================="
} >> "${TRIM_TEMP_LOGFILE:-/tmp/ds2api-install.log}" 2>&1

exit 0

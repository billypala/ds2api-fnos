#!/bin/bash

### 注意：fnpack 打包后，app.tgz 内部路径已剥掉 app/ 前缀，
### 所以所有资源都直接在 ${TRIM_APPDEST} 下（不是 ${TRIM_APPDEST}/app/）

DATA_DIR="${TRIM_PKGVAR}"
APP_BIN="${TRIM_APPDEST}/ds2api"
STATIC_ADMIN_DIR="${TRIM_APPDEST}/static/admin"
CONFIG_FILE="${DATA_DIR}/config.json"
LOG_FILE="${DATA_DIR}/app.log"
PID_FILE="${DATA_DIR}/app.pid"
SERVICE_PORT="${TRIM_SERVICE_PORT:-5001}"

is_running() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
    rm -f "${PID_FILE}"
  fi
  return 1
}

start_app() {
  if is_running; then
    return 0
  fi

  if [ ! -x "${APP_BIN}" ]; then
    echo "Binary not found or not executable: ${APP_BIN}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    return 1
  fi

  mkdir -p "${DATA_DIR}"

  cd "${TRIM_APPDEST}" || exit 1

  DS2API_CONFIG_PATH="${CONFIG_FILE}" \
  DS2API_STATIC_ADMIN_DIR="${STATIC_ADMIN_DIR}" \
  DS2API_ADMIN_KEY="${ds2api_admin_key}" \
  PORT="${SERVICE_PORT}" \
  TZ=Asia/Shanghai \
  LOG_LEVEL=INFO \
  nohup "${APP_BIN}" >> "${LOG_FILE}" 2>&1 &

  local pid=$!
  echo "${pid}" > "${PID_FILE}"

  sleep 1
  if ! kill -0 "${pid}" 2>/dev/null; then
    echo "ds2api failed to start. Check ${LOG_FILE}." > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    rm -f "${PID_FILE}"
    return 1
  fi
}

stop_app() {
  if [ ! -f "${PID_FILE}" ]; then
    return 0
  fi

  local pid
  pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')

  if [ -z "${pid}" ] || ! kill -0 "${pid}" 2>/dev/null; then
    rm -f "${PID_FILE}"
    return 0
  fi

  kill -TERM "${pid}" 2>/dev/null || true

  local count=0
  while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if kill -0 "${pid}" 2>/dev/null; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi

  rm -f "${PID_FILE}"
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
    ;;
esac
